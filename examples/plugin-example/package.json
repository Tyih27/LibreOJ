{
  "name": "libreoj-plugin-example",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "libreoj": {
    "entry": "dist/index.js",
    "config": {
      "greeting": "hello from libreoj-plugin-example"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-format": "prettier --check \"src/**/*.ts\" \"*.json\"",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\"",
    "test": "pnpm build && tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@libreoj/plugin-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "18.6.3",
    "prettier": "catalog:",
    "tsx": "4.23.1",
    "typescript": "^4.7.4"
  }
}
