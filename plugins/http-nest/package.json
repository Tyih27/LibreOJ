{
  "name": "@libreoj/plugin-http-nest",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "libreoj": {
    "entry": "dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-format": "prettier --check \"src/**/*.ts\" \"*.json\"",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\"",
    "test": "tsx --test src/*.test.ts"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.7",
    "@nestjs/core": "^9.0.7",
    "@nestjs/platform-express": "^9.0.7"
  },
  "dependencies": {
    "@libreoj/plugin-api": "workspace:*",
    "@libreoj/plugin-core": "workspace:*",
    "express": "4.18.1"
  },
  "devDependencies": {
    "@nestjs/common": "^9.0.7",
    "@nestjs/core": "^9.0.7",
    "@nestjs/platform-express": "^9.0.7",
    "@types/express": "^4.17.13",
    "@types/node": "18.6.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "prettier": "catalog:",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.5.6",
    "tsx": "4.23.1",
    "typescript": "^4.7.4"
  }
}
